{
  "name": "jobbot",
  "version": "0.1.0",
  "private": true,
  "description": "Web-UI personal job-search assistant — high quality, not high volume. Dashboard, pipeline, LaTeX resumes, AI scoring.",
  "type": "module",
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "scripts": {
    "jobbot": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "js-yaml": "^4.3.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "undici": ">=7.29.0 <8",
      "vite": "6.4.3"
    }
  }
