<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JobBot — <%= typeof title === 'string' ? title : 'Dashboard' %></title>
  <style>
    /* ----- reset & base -------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d1117;
      --bg-elevated: #161b22;
      --bg-hover: #1c2333;
      --border: #30363d;
      --text: #e6edf3;
      --text-muted: #8b949e;
      --text-dim: #6e7681;
      --accent: #58a6ff;
      --green: #3fb950;
      --yellow: #d2991d;
      --orange: #db6d28;
      --red: #f85149;
      --purple: #a371f7;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ----- nav ----------------------------------------------------------- */
    nav {
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
      height: 48px;
      display: flex;
      align-items: center;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    nav .logo {
      font-weight: 700;
      font-size: 16px;
      color: var(--accent);
      text-decoration: none;
    }
    nav .logo span { color: var(--text-muted); font-weight: 400; }
    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
    }
    nav a:hover { color: var(--text); }

    /* ----- layout -------------------------------------------------------- */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
    }

    /* ----- stats bar ----------------------------------------------------- */
    .stats-bar {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .stat {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .stat strong { color: var(--text); font-size: 18px; margin-right: 4px; }

    /* ----- filters ------------------------------------------------------- */
    .filter-bar {
      display: flex;
      gap: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
      align-items: center;
    }
    .filter-bar label {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .filter-bar select {
      background: var(--bg-elevated);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 13px;
      cursor: pointer;
    }
    .filter-bar select:focus { outline: none; border-color: var(--accent); }

    /* ----- table --------------------------------------------------------- */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    thead {
      position: sticky;
      top: 48px;
      z-index: 5;
    }
    th {
      text-align: left;
      padding: 10px 12px;
      background: var(--bg-elevated);
      border-bottom: 2px solid var(--border);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }
    td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    tr:hover td { background: var(--bg-hover); }
    tr.clickable { cursor: pointer; }
    tr.clickable td:first-child { color: var(--text-dim); font-variant-numeric: tabular-nums; }

    /* ----- badges -------------------------------------------------------- */
    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .tier-a { background: rgba(63,185,80,0.15); color: var(--green); }
    .tier-b { background: rgba(88,166,255,0.15); color: var(--accent); }
    .tier-c { background: rgba(210,153,29,0.15); color: var(--yellow); }
    .tier-d { background: rgba(248,81,73,0.15); color: var(--red); }
    .tier-none { background: rgba(110,118,129,0.15); color: var(--text-dim); }

    .status-badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 10px;
      color: var(--text-muted);
      background: rgba(110,118,129,0.15);
    }

    /* ----- detail page --------------------------------------------------- */
    .back-link {
      display: inline-block;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13px;
      margin-bottom: 20px;
    }
    .back-link:hover { color: var(--text); }

    .job-header { margin-bottom: 24px; }
    .job-header h1 { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
    .job-header .meta { font-size: 15px; color: var(--text-muted); }
    .job-header .meta strong { color: var(--text); }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }
    @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } }

    .card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 20px;
    }
    .card h2 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .score-display {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }
    .score-number {
      font-size: 48px;
      font-weight: 700;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .score-reason { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
    .score-reason p { margin-bottom: 8px; }
    .score-reason p:last-child { margin-bottom: 0; }

    .detail-row {
      display: flex;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label {
      width: 130px;
      flex-shrink: 0;
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .detail-value { color: var(--text); word-break: break-word; }
    .detail-value a { color: var(--accent); }

    .description-box {
      max-height: 400px;
      overflow-y: auto;
      white-space: pre-wrap;
      font-size: 13px;
      line-height: 1.6;
      color: var(--text-muted);
    }

    /* ----- pipeline tracker ---------------------------------------------- */
    .pipeline-steps {
      display: flex;
      gap: 0;
      align-items: center;
    }
    .pipeline-step {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-dim);
    }
    .pipeline-step .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--border);
      flex-shrink: 0;
    }
    .pipeline-step.done .dot { background: var(--green); }
    .pipeline-step.current .dot {
      background: var(--accent);
      box-shadow: 0 0 0 3px rgba(88,166,255,0.25);
    }
    .pipeline-step.done { color: var(--text); }
    .pipeline-step.current { color: var(--accent); font-weight: 600; }
    .pipeline-connector {
      width: 24px;
      height: 1px;
      background: var(--border);
      margin: 0 4px;
    }
    .pipeline-connector.done { background: var(--green); }

    /* ----- empty state --------------------------------------------------- */
    .empty { text-align: center; padding: 48px; color: var(--text-dim); }
    .empty p { margin-top: 8px; font-size: 14px; }

    /* ----- delete button -------------------------------------------------- */
    .delete-btn {
      background: none;
      border: 1px solid transparent;
      color: var(--text-dim);
      cursor: pointer;
      font-size: 14px;
      padding: 2px 6px;
      border-radius: 4px;
      line-height: 1;
      transition: all 0.15s;
    }
    .delete-btn:hover {
      color: var(--red);
      border-color: rgba(248,81,73,0.3);
      background: rgba(248,81,73,0.1);
    }
    .delete-link {
      color: var(--red);
      text-decoration: none;
      font-size: 13px;
      cursor: pointer;
    }
    .delete-link:hover { text-decoration: underline; }
    .confirm-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 100;
      align-items: center;
      justify-content: center;
    }
    .confirm-overlay.open { display: flex; }
    .confirm-box {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 24px;
      max-width: 400px;
      width: 90%;
    }
    .confirm-box h3 { margin-bottom: 12px; color: var(--red); }
    .confirm-box p { margin-bottom: 16px; color: var(--text-muted); font-size: 14px; }
    .confirm-actions { display: flex; gap: 8px; justify-content: flex-end; }
    .btn-cancel {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
    }
    .btn-danger {
      background: var(--red);
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }
    .btn-cancel:hover { background: var(--bg-hover); }
    .btn-danger:hover { filter: brightness(1.1); }

    /* ----- URL link ------------------------------------------------------ */
    .url-link { color: var(--accent); text-decoration: none; font-size: 12px; }
    .url-link:hover { text-decoration: underline; }

    /* ----- responsive table ---------------------------------------------- */
    @media (max-width: 900px) {
      table { font-size: 12px; }
      th, td { padding: 8px 6px; }
    }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="logo">JobBot <span>v0.5</span></a>
    <a href="/">Dashboard</a>
    <a href="/add-urls">Add URLs</a>
    <a href="/pipeline">Pipeline</a>
    <a href="/events">Events</a>
    <a href="/profile">Profile</a>
    <a href="/ai-log">AI Log</a>
  </nav>
  <div class="container">
