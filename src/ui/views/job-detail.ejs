<%- include('_head', { title: job.title || ('Job #' + job.id) }) %>

<a href="/" class="back-link">← Back to Dashboard</a>

<!-- job header -->
<div class="job-header" style="display:flex;justify-content:space-between;align-items:flex-start">
  <div>
    <h1><%= job.title || 'Untitled' %></h1>
    <p class="meta">
      <strong><%= job.company || 'Unknown Company' %></strong>
      <% if (job.location) { %> · <%= job.location %><% } %>
      <% if (job.ats_type) { %> · <span style="color:var(--text-dim);font-size:12px"><%= job.ats_type %></span><% } %>
    </p>
  </div>
  <span class="delete-link" onclick="deleteJob(<%= job.id %>, '<%= (job.title || 'Untitled').replace(/'/g, "\\'") %>')" title="Delete this job">🗑️ Delete</span>
</div>

<!-- pipeline tracker -->
<div class="card" style="margin-bottom:20px">
  <h2>Pipeline Progress</h2>
  <%
    const stages = [
      { key: 'new', label: 'Ingest' },
      { key: 'extracted', label: 'Extract' },
      { key: 'scored', label: 'Score' },
      { key: 'composed', label: 'Compose' },
      { key: 'audited', label: 'Audit' },
      { key: 'applied', label: 'Apply' },
    ];
    const currentIdx = stages.findIndex(s => s.key === job.status);
  %>
  <div class="pipeline-steps" style="flex-wrap:wrap;gap:4px">
    <% for (let i = 0; i < stages.length; i++) { %>
      <% if (i > 0) { %>
        <div class="pipeline-connector <%= i <= currentIdx ? 'done' : '' %>" style="margin:0 2px"></div>
      <% } %>
      <div class="pipeline-step <%= i < currentIdx ? 'done' : (i === currentIdx ? 'current' : '') %>">
        <div class="dot"></div>
        <span><%= stages[i].label %></span>
      </div>
    <% } %>
  </div>
  <p style="margin-top:12px;font-size:12px;color:var(--text-dim)">
    Status: <strong style="color:var(--text)"><%= helpers.statusLabel(job.status) %></strong>
    &nbsp;·&nbsp; Added <%= job.discovered_at %>
  </p>
</div>

<!-- score + market data (side by side on wide screens) -->
<div class="grid-2">

  <!-- score card -->
  <div class="card">
    <h2>Score</h2>
    <% if (job.score != null) { %>
      <div class="score-display">
        <div class="score-number" style="color:<%=
          job.tier === 'A' ? 'var(--green)' :
          job.tier === 'B' ? 'var(--accent)' :
          job.tier === 'C' ? 'var(--yellow)' : 'var(--red)'
        %>"><%= helpers.scoreFmt(job.score) %></div>
        <span class="badge <%= helpers.tierClass(job.tier) %>" style="font-size:14px;padding:4px 12px"><%= helpers.tierLabel(job.tier) %></span>
      </div>
      <% if (reasonParagraphs.length > 0) { %>
        <div class="score-reason">
          <% for (const p of reasonParagraphs) { %>
            <p><%= p.trim() %></p>
          <% } %>
        </div>
      <% } %>
      <div class="regenerate-row">
        <input type="text" id="instr-score" class="instr-input" placeholder="Optional: e.g. 'Focus on backend skills'..." />
        <button class="btn-regen" onclick="regenerate('score', 'instr-score')">🔄 Re-score</button>
        <span class="regen-status" id="status-score"></span>
      </div>
    <% } else { %>
      <p style="color:var(--text-dim)">Not scored yet.</p>
    <% } %>
  </div>

  <!-- market data card -->
  <div class="card">
    <h2>Market Intelligence</h2>
    <% if (salaryMarket.length > 0 || skillMarket.length > 0) { %>

      <% if (salaryMarket.length > 0) { %>
        <h3 style="font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Salary Ranges</h3>
        <% for (const s of salaryMarket.slice(0, 5)) { %>
          <%
            const sParts = s.key.split('.');
            const sTitle = (sParts[1] || '?').replace(/_/g, ' ');
            const sLoc = (sParts[2] || '?').replace(/_/g, ' ');
          %>
          <div style="font-size:12px;margin-bottom:3px;display:flex;justify-content:space-between">
            <span style="color:var(--text-muted)"><%= sTitle %> · <%= sLoc %></span>
            <span style="color:var(--green);font-weight:600"><%= s.value %></span>
          </div>
        <% } %>
        <div style="height:1px;background:var(--border);margin:10px 0"></div>
      <% } %>

      <% if (skillMarket.length > 0) { %>
        <h3 style="font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Top Skills in Market</h3>
        <div style="display:flex;flex-wrap:wrap;gap:4px">
          <% for (const sk of skillMarket.slice(0, 12)) { %>
            <%
              const skName = sk.key.split('.').slice(1).join('.').replace(/_/g, ' ');
              const skPct = (parseFloat(sk.value) * 100).toFixed(0);
            %>
            <span style="background:rgba(88,166,255,0.1);color:var(--accent);font-size:11px;padding:2px 8px;border-radius:10px" title="<%= skPct %>% of jobs (n=<%= sk.sample_size %>)"><%= skName %></span>
          <% } %>
        </div>
      <% } %>

      <% if (titleMarket.length > 0) { %>
        <div style="height:1px;background:var(--border);margin:10px 0"></div>
        <h3 style="font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px">Similar Titles</h3>
        <% for (const t of titleMarket.slice(0, 5)) { %>
          <%
            const tName = t.key.split('.').slice(1).join('.').replace(/_/g, ' ');
            const tPct = (parseFloat(t.value) * 100).toFixed(0);
          %>
          <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px">
            <%= tName %> <span style="color:var(--text-dim)">(<%= tPct %>% of market)</span>
          </div>
        <% } %>
      <% } %>

    <% } else { %>
      <p style="color:var(--text-dim);font-size:13px">No market data yet. Score some jobs to populate market intelligence.</p>
    <% } %>
  </div>
</div>

<!-- extracted data + description -->
<div class="grid-2">
  <!-- extracted -->
  <div class="card">
    <h2>Extracted Data</h2>
    <% if (job.title) { %>
      <div class="detail-row"><span class="detail-label">Title</span><span class="detail-value"><%= job.title %></span></div>
      <div class="detail-row"><span class="detail-label">Company</span><span class="detail-value"><%= job.company || '-' %></span></div>
      <div class="detail-row"><span class="detail-label">Location</span><span class="detail-value"><%= job.location || '-' %></span></div>
      <div class="detail-row"><span class="detail-label">ATS</span><span class="detail-value"><%= job.ats_type %></span></div>
      <% if (typeof jobSalaries !== 'undefined' && jobSalaries.length > 0) { %>
      <div class="detail-row">
        <span class="detail-label">Salary</span>
        <span class="detail-value" style="color:var(--green);font-weight:600">
          <% for (let si = 0; si < jobSalaries.length; si++) { %>
            <%= si > 0 ? ' · ' : '' %>$<%= Math.round(jobSalaries[si].low / 1000) %>k–$<%= Math.round(jobSalaries[si].high / 1000) %>k
          <% } %>
          <span style="font-size:10px;color:var(--text-dim);font-weight:400;margin-left:6px"><%= typeof jobSkills !== 'undefined' && jobSkills.length > 0 ? '(LLM-extracted)' : '(regex)' %></span>
        </span>
      </div>
      <% } %>
      <% if (typeof jobSkills !== 'undefined' && jobSkills.length > 0) { %>
      <div class="detail-row">
        <span class="detail-label">Skills</span>
        <span class="detail-value">
          <% for (let si = 0; si < Math.min(jobSkills.length, 20); si++) { %>
            <span style="background:rgba(88,166,255,0.1);color:var(--accent);font-size:11px;padding:1px 8px;border-radius:10px;margin-right:4px;margin-bottom:4px;display:inline-block"><%= jobSkills[si] %></span>
          <% } %>
          <% if (jobSkills.length > 20) { %><span style="font-size:11px;color:var(--text-dim)">+<%= jobSkills.length - 20 %> more</span><% } %>
        </span>
      </div>
      <% } %>
      <% if (job.apply_url) { %>
      <div class="detail-row"><span class="detail-label">Apply URL</span><span class="detail-value"><a href="<%= job.apply_url %>" target="_blank"><%= helpers.truncate(job.apply_url, 50) %></a></span></div>
      <% } %>
      <div class="detail-row"><span class="detail-label">Source</span><span class="detail-value"><a href="<%= job.url %>" target="_blank"><%= helpers.truncate(job.url, 50) %></a></span></div>
      <div class="regenerate-row">
        <input type="text" id="instr-extract" class="instr-input" placeholder="Optional: AI instruction for re-extract..." />
        <button class="btn-regen" onclick="regenerate('extract', 'instr-extract')">🔄 Re-extract</button>
        <span class="regen-status" id="status-extract"></span>
      </div>
    <% } else { %>
      <p style="color:var(--text-dim)">Not extracted yet.</p>
    <% } %>
  </div>

  <!-- description -->
  <div class="card">
    <h2>Job Description</h2>
    <% if (job.description) { %>
      <div class="description-box"><%= job.description %></div>
    <% } else { %>
      <p style="color:var(--text-dim)">No description extracted yet.</p>
    <% } %>
  </div>
</div>

<!-- compose result -->
<div class="card" style="margin-top:20px">
  <h2>Resume Documents</h2>
  <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start">
    <% if (resumeVersion && resumeVersion.pdf_path) { %>
      <div>
        <a href="<%= '/resumes/' + resumeVersion.pdf_path.split('/').pop() %>" class="btn-link" download>📥 Download Resume PDF</a>
        <p style="font-size:11px;color:var(--text-dim);margin-top:4px"><%= resumeVersion.pdf_path %></p>
      </div>
    <% } else { %>
      <p style="color:var(--text-dim);font-size:13px">No resume PDF yet.</p>
    <% } %>

    <% if (hasCoverLetter) { %>
      <div>
        <a href="<%= '/resumes/' + job.id + '-cover-letter.pdf' %>" class="btn-link" download>📥 Download Cover Letter</a>
      </div>
    <% } %>

    <!-- generate cover letter -->
    <% if (job.description) { %>
      <div style="display:flex;align-items:center;gap:8px">
        <select id="cl-tone" style="background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:4px;padding:6px 10px;font-size:12px">
          <option value="professional">Professional</option>
          <option value="enthusiastic">Enthusiastic</option>
          <option value="concise">Concise</option>
        </select>
        <button id="cl-btn" class="btn-regen" onclick="generateCoverLetter()"><%= hasCoverLetter ? '🔄 Regenerate' : '✨ Generate Cover Letter' %></button>
        <span id="cl-status" style="font-size:11px;color:var(--text-dim)"></span>
      </div>
    <% } %>
  </div>
  <div class="regenerate-row">
    <input type="text" id="instr-compose" class="instr-input" placeholder="Optional: e.g. 'Emphasize AWS experience'..." />
    <button class="btn-regen" onclick="regenerate('compose', 'instr-compose')">🔄 Re-compose</button>
    <span class="regen-status" id="status-compose"></span>
  </div>
</div>

<!-- audit result -->
<div class="card" style="margin-top:20px">
  <h2>Audit Results</h2>
  <% if (auditData) { %>
    <div style="display:flex;gap:24px;margin-bottom:12px;flex-wrap:wrap">
      <div style="text-align:center">
        <div style="font-size:32px;font-weight:700;color:<%= auditData.overallScore >= 70 ? 'var(--green)' : 'var(--red)' %>"><%= auditData.overallScore ?? '-' %></div>
        <div style="font-size:10px;color:var(--text-dim);text-transform:uppercase">Overall /100</div>
      </div>
      <div style="text-align:center">
        <div style="font-size:32px;font-weight:700;color:var(--accent)"><%= auditData.contentScore ?? '-' %></div>
        <div style="font-size:10px;color:var(--text-dim);text-transform:uppercase">Content</div>
      </div>
      <div style="text-align:center">
        <div style="font-size:32px;font-weight:700;color:var(--purple)"><%= auditData.visualScore ?? '-' %></div>
        <div style="font-size:10px;color:var(--text-dim);text-transform:uppercase">Visual</div>
      </div>
    </div>

    <% const allIssues = [...(auditData.contentIssues || []), ...(auditData.visualIssues || [])]; %>
    <% if (allIssues.length > 0) { %>
      <p style="font-size:12px;color:var(--text-muted);margin-bottom:8px"><%= allIssues.length %> issue(s) found (<%= (auditData.contentIssues || []).length %> content, <%= (auditData.visualIssues || []).length %> visual)</p>
      <ul style="font-size:12px;color:var(--text-muted);padding-left:18px;line-height:1.8">
        <% for (const issue of allIssues) { %>
          <li><%= typeof issue === 'string' ? issue : (issue.description || issue.issue || JSON.stringify(issue)) %></li>
        <% } %>
      </ul>
    <% } else { %>
      <p style="color:var(--green);font-size:13px">✓ No issues found</p>
    <% } %>

  <% } else { %>
    <p style="color:var(--text-dim);font-size:13px">Not audited yet.</p>
  <% } %>
  <div class="regenerate-row">
    <input type="text" id="instr-audit" class="instr-input" placeholder="Optional: AI instruction for re-audit..." />
    <button class="btn-regen" onclick="regenerate('audit', 'instr-audit')">🔄 Re-audit</button>
    <span class="regen-status" id="status-audit"></span>
  </div>
</div>

<!-- event timeline -->
<% if (events && events.length > 0) { %>
  <div class="card" style="margin-top:24px">
    <h2>Event Timeline</h2>
    <div style="position:relative;padding-left:20px">
      <div style="position:absolute;left:4px;top:4px;bottom:4px;width:2px;background:var(--border)"></div>
      <% for (const e of events) { %>
        <div style="position:relative;padding:6px 0 6px 16px;font-size:13px">
          <% const dotColor =
            e.event_type === 'ingest' ? '#a371f7' :
            e.event_type === 'extract' ? '#58a6ff' :
            e.event_type === 'score' ? '#3fb950' :
            e.event_type === 'compose' ? '#d2991d' :
            e.event_type === 'cover_letter' ? '#db6d28' :
            e.event_type === 'audit_pass' ? '#3fb950' :
            e.event_type === 'audit_fail' ? '#f85149' :
            e.event_type === 'regenerate' ? '#a371f7' :
            '#6e7681';
          %>
          <div style="position:absolute;left:-18px;top:11px;width:8px;height:8px;border-radius:50%;background:<%= dotColor %>;border:2px solid var(--bg);z-index:1"></div>
          <span style="color:var(--text-dim);font-size:11px;margin-right:8px"><%= e.created_at %></span>
          <span style="color:var(--text);font-weight:600"><%= e.event_type %></span>
          <% if (e.description) { %><span style="color:var(--text-muted)"> — <%= e.description %></span><% } %>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<style>
.stage-detail {
  margin-top: 16px; padding: 16px; background: var(--bg);
  border: 1px solid var(--border); border-radius: 6px;
}
.stage-detail h3 { font-size: 14px; font-weight: 600; margin-bottom: 12px; color: var(--text); }
.regenerate-row {
  margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border);
  display: flex; gap: 8px; align-items: center;
}
.instr-input {
  flex: 1; background: var(--bg-elevated); color: var(--text);
  border: 1px solid var(--border); border-radius: 4px;
  padding: 6px 10px; font-size: 12px; font-family: inherit;
}
.instr-input:focus { outline: none; border-color: var(--accent); }
.instr-input::placeholder { color: var(--text-dim); }
.btn-regen {
  background: none; border: 1px solid var(--border); color: var(--text-muted);
  padding: 6px 12px; border-radius: 4px; cursor: pointer;
  font-size: 12px; font-weight: 600; white-space: nowrap;
  transition: all 0.15s;
}
.btn-regen:hover { border-color: var(--accent); color: var(--accent); }
.regen-status { font-size: 11px; color: var(--text-dim); white-space: nowrap; }
.btn-link {
  display: inline-block; background: rgba(88,166,255,0.1); color: var(--accent);
  border: 1px solid rgba(88,166,255,0.3); padding: 8px 16px;
  border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 600;
  transition: all 0.15s;
}
.btn-link:hover { background: rgba(88,166,255,0.2); }
</style>

<script>
// Regenerate a pipeline step
async function regenerate(step, inputId) {
  if (!confirm(`Regenerate ${step} for this job? This will reset the pipeline back to before ${step} and re-run.`)) return;
  const instruction = document.getElementById(inputId).value.trim();
  const statusEl = document.getElementById('status-' + step);
  statusEl.textContent = '⏳ Running...';
  statusEl.style.color = 'var(--yellow)';
  try {
    const resp = await fetch(`/api/jobs/<%= job.id %>/regenerate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ step, instruction: instruction || undefined }),
    });
    const data = await resp.json();
    if (data.ok) {
      statusEl.textContent = '✓ Started — page will refresh';
      statusEl.style.color = 'var(--green)';
      setTimeout(() => window.location.reload(), 2000);
    } else {
      statusEl.textContent = '✕ ' + (data.error || 'Failed');
      statusEl.style.color = 'var(--red)';
    }
  } catch (err) {
    statusEl.textContent = '✕ ' + err.message;
    statusEl.style.color = 'var(--red)';
  }
}

// Generate cover letter with tone
async function generateCoverLetter() {
  if (!confirm('Generate a cover letter for this job via AI? This will replace any existing one.')) return;
  const tone = document.getElementById('cl-tone').value;
  const btn = document.getElementById('cl-btn');
  const status = document.getElementById('cl-status');
  btn.disabled = true; status.textContent = '⏳ Generating...'; status.style.color = 'var(--yellow)';
  try {
    const resp = await fetch('/api/jobs/<%= job.id %>/cover-letter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tone }),
    });
    const data = await resp.json();
    if (data.ok) {
      status.innerHTML = '✓ <a href="/resumes/<%= job.id %>-cover-letter.pdf?' + Date.now() + '" style="color:var(--accent)" download>Download</a>';
      status.style.color = 'var(--green)';
      btn.textContent = '🔄 Regenerate';
    } else {
      status.textContent = '✕ ' + (data.error || 'Failed');
      status.style.color = 'var(--red)';
    }
  } catch (err) {
    status.textContent = '✕ ' + err.message;
    status.style.color = 'var(--red)';
  }
  btn.disabled = false;
}

async function deleteJob(id, label) {
  if (!confirm(`Delete job #${id}: "${label}"?\n\nThis is permanent and cannot be undone.`)) return;
  const resp = await fetch(`/api/jobs/${id}/delete`, { method: 'POST' });
  if (resp.ok) {
    window.location.href = '/';
  } else {
    const data = await resp.json();
    alert(`Delete failed: ${data.error}`);
  }
}
</script>
<%- include('_foot') %>
