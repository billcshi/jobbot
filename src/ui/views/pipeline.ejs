<%- include('_head', { title: 'Pipeline' }) %>

<style>
  .pipeline-flow { position: relative; padding-left: 48px; }
  .pipeline-flow::before {
    content: ''; position: absolute; left: 23px; top: 8px; bottom: 8px;
    width: 2px; background: var(--border);
  }
  .stage {
    position: relative; margin-bottom: 32px; padding: 20px 24px;
    background: var(--bg-elevated); border: 1px solid var(--border);
    border-radius: 8px; transition: border-color 0.2s;
  }
  .stage:hover { border-color: var(--accent); }
  .stage::before {
    content: ''; position: absolute; left: -33px; top: 28px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--border); border: 2px solid var(--bg); z-index: 1;
  }
  .stage.active::before {
    background: var(--accent); box-shadow: 0 0 0 4px rgba(88,166,255,0.2);
  }
  .stage.done::before { background: var(--green); }
  .stage-header {
    display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
  }
  .stage-number {
    font-size: 12px; font-weight: 700; color: var(--accent);
    background: rgba(88,166,255,0.12); padding: 3px 8px; border-radius: 4px;
    white-space: nowrap;
  }
  .stage-title { font-size: 16px; font-weight: 600; color: var(--text); }
  .stage-cmd {
    font-size: 12px; font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;
    color: var(--text-dim); background: var(--bg); padding: 2px 8px;
    border-radius: 4px; margin-left: auto;
  }
  .comp-flow { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
  .comp {
    padding: 10px 14px; border-radius: 6px; font-size: 12px; text-align: center;
    min-width: 90px; transition: all 0.15s;
  }
  .comp-title {
    font-weight: 600; font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.3px; margin-bottom: 4px;
  }
  .comp-detail { color: var(--text-muted); font-size: 11px; }
  .comp-detail a { color: var(--accent); }
  .comp-url    { background: rgba(163,113,247,0.10); border: 1px solid rgba(163,113,247,0.25); }
  .comp-parse  { background: rgba(210,153,29,0.10);  border: 1px solid rgba(210,153,29,0.25); }
  .comp-db     { background: rgba(63,185,80,0.10);   border: 1px solid rgba(63,185,80,0.25); }
  .comp-fetch  { background: rgba(88,166,255,0.10);  border: 1px solid rgba(88,166,255,0.25); }
  .comp-llm    { background: rgba(248,81,73,0.10);   border: 1px solid rgba(248,81,73,0.25); }
  .comp-render { background: rgba(210,153,29,0.10);  border: 1px solid rgba(210,153,29,0.25); }
  .comp-apply  { background: rgba(163,113,247,0.10); border: 1px solid rgba(163,113,247,0.25); }
  .comp-output { background: rgba(63,185,80,0.08);   border: 1px solid rgba(63,185,80,0.20); }
  .comp-arrow {
    display: flex; align-items: center; color: var(--text-dim);
    font-size: 18px; padding: 0 4px;
  }

  /* stage footer */
  .stage-foot {
    font-size: 12px; margin-top: 12px; padding-top: 10px;
    border-top: 1px solid var(--border);
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .stage-foot strong { color: var(--text); }
  .metric { display: flex; align-items: center; gap: 3px; font-size: 11px; }
  .metric .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .dot-ok  { background: var(--green); }
  .dot-wait { background: var(--yellow); }
  .dot-fail { background: var(--red); }

  .toggle-badge {
    font-size: 11px; padding: 2px 8px; border-radius: 10px; cursor: pointer;
    user-select: none; transition: background 0.15s;
  }
  .toggle-badge:hover { filter: brightness(1.2); }
  .toggle-badge.wait { background: rgba(210,153,29,0.12); color: var(--yellow); }
  .toggle-badge.fail { background: rgba(248,81,73,0.12); color: var(--red); }
  .toggle-badge.empty { background: rgba(110,118,129,0.10); color: var(--text-dim); cursor: default; }
  .toggle-badge.empty:hover { filter: none; }

  /* expandable job list */
  .job-queue {
    display: none; margin-top: 10px; padding-top: 10px;
    border-top: 1px solid var(--border); font-size: 12px;
    max-height: 220px; overflow-y: auto;
  }
  .job-queue.open { display: block; }
  .job-queue-item {
    display: flex; align-items: center; gap: 8px; padding: 4px 0;
    color: var(--text-muted); border-bottom: 1px solid rgba(48,54,61,0.5);
  }
  .job-queue-item:last-child { border-bottom: none; }
  .job-queue-item .jid { color: var(--text-dim); min-width: 28px; }
  .job-queue-item a { color: var(--accent); text-decoration: none; }
  .job-queue-item a:hover { text-decoration: underline; }
  .job-queue-item .tag {
    font-size: 10px; padding: 1px 5px; border-radius: 3px;
    background: var(--bg); color: var(--text-dim);
  }
  .job-queue-item .err {
    font-size: 10px; color: var(--red); max-width: 400px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .queue-run-btn {
    margin-left: auto; background: none; border: none;
    color: var(--text-dim); cursor: pointer; font-size: 14px;
    padding: 2px 8px; border-radius: 4px; flex-shrink: 0;
    transition: all 0.15s;
  }
  .queue-run-btn:hover {
    color: var(--green); background: rgba(63,185,80,0.1);
  }
  .queue-del-btn {
    margin-left: 0; background: none; border: none;
    color: var(--text-dim); cursor: pointer; font-size: 14px;
    padding: 2px 6px; border-radius: 4px; flex-shrink: 0;
  }
  .queue-del-btn:hover {
    color: var(--red); background: rgba(248,81,73,0.1);
  }

  .source-label {
    font-size: 11px; color: var(--text-dim); text-transform: uppercase;
    letter-spacing: 0.5px; margin-bottom: 16px; padding-left: 48px;
    display: flex; align-items: center; gap: 8px;
  }
  .source-label::before {
    content: ''; width: 14px; height: 14px; border-radius: 50%;
    background: var(--purple); border: 2px solid var(--bg); flex-shrink: 0;
  }
  .source-icons { color: var(--text-muted); font-size: 13px; }
  .page-header { margin-bottom: 28px; }
  .page-header h1 { font-size: 20px; font-weight: 600; margin-bottom: 6px; }
  .page-header p { color: var(--text-muted); font-size: 14px; }
  .btn-run {
    background: var(--green);
    color: #fff;
    border: none;
    padding: 8px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.15s;
  }
  .btn-run:hover { filter: brightness(1.15); }
  .btn-run:disabled { background: var(--border); color: var(--text-dim); cursor: not-allowed; }
  .btn-cancel {
    background: var(--red);
    color: #fff;
    border: none;
    padding: 6px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    margin-left: 8px;
    transition: all 0.15s;
  }
  .btn-cancel:hover { filter: brightness(1.15); }

  /* live pipeline status panel */
  .live-panel {
    display: none; margin-bottom: 24px; padding: 20px 24px;
    background: rgba(88,166,255,0.06); border: 1px solid var(--accent);
    border-radius: 8px;
  }
  .live-panel.open { display: block; }
  .live-panel h3 {
    font-size: 14px; font-weight: 600; color: var(--accent);
    margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
  }
  .live-panel h3 .spinner {
    display: inline-block; width: 14px; height: 14px;
    border: 2px solid var(--accent); border-top-color: transparent;
    border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .live-stages { display: flex; gap: 8px; flex-wrap: wrap; }
  .live-stage {
    flex: 1; min-width: 160px; padding: 10px 14px;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 6px; font-size: 12px;
  }
  .live-stage.active { border-color: var(--accent); background: rgba(88,166,255,0.05); }
  .live-stage.done { border-color: var(--green); opacity: 0.7; }
  .live-stage .ls-name { font-weight: 600; margin-bottom: 4px; }
  .live-stage .ls-bar {
    height: 4px; background: var(--border); border-radius: 2px;
    margin: 6px 0; overflow: hidden;
  }
  .live-stage .ls-bar-fill {
    height: 100%; background: var(--accent); border-radius: 2px;
    transition: width 0.3s;
  }
  .live-stage.done .ls-bar-fill { background: var(--green); }
  .live-stage .ls-stats { color: var(--text-dim); font-size: 11px; }
  .live-stage .ls-running {
    color: var(--accent); font-size: 10px; margin-top: 4px;
    max-height: 60px; overflow-y: auto;
  }

  /* task pool table */
  .task-pool { margin-top: 18px; }
  .task-pool h4 { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .task-pool table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .task-pool th { text-align: left; font-weight: 600; color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 8px; border-bottom: 1px solid var(--border); }
  .task-pool td { padding: 5px 8px; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
  .task-pool .task-status {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; font-weight: 500;
  }
  .task-pool .task-status.running { color: var(--accent); }
  .task-pool .task-status.done { color: var(--green); }
  .task-pool .task-status.fail { color: var(--red); }
  .task-pool .task-status.cancelled { color: var(--yellow); }
  .task-row { transition: opacity 0.6s ease-out, max-height 0.6s ease-out; }
  .task-row.fading { opacity: 0; max-height: 0; overflow: hidden; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .task-row.new-done { animation: fadeIn 0.3s ease-out; }
  .task-pool .task-spinner {
    display: inline-block; width: 10px; height: 10px;
    border: 2px solid currentColor; border-top-color: transparent;
    border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  .btn-task-cancel {
    background: none; border: 1px solid var(--red); color: var(--red);
    padding: 2px 8px; border-radius: 4px; cursor: pointer;
    font-size: 10px; font-weight: 600; transition: all 0.15s;
  }
  .btn-task-cancel:hover { background: var(--red); color: #fff; }
</style>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start">
  <div>
    <h1>Data Pipeline</h1>
    <p>How job postings flow from URL to application-ready resume. Click badges to inspect each queue.</p>
  </div>
  <div style="text-align:right;flex-shrink:0">
    <button id="run-btn" class="btn-run" onclick="startPipeline()" title="Run the full pipeline (extract → score → compose → audit)">▶ Run Pipeline</button>
    <button id="cancel-btn" class="btn-cancel" style="display:none" onclick="cancelPipeline()" title="Cancel the running pipeline">✕ Cancel</button>
    <div id="run-progress" style="display:none;margin-top:8px;font-size:12px;color:var(--text-muted)">
      <span id="run-stage"></span>
      <span id="run-spinner" style="display:none"> ⏳</span>
    </div>
    <select id="run-step" style="margin-top:4px;background:var(--bg);color:var(--text-dim);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-size:11px">
      <option value="">Full pipeline</option>
      <option value="extract">Extract only</option>
      <option value="score">Score only</option>
      <option value="compose">Compose only</option>
      <option value="audit">Audit only</option>
    </select>
  </div>
</div>

<!-- Live pipeline status panel -->
<div class="live-panel" id="live-panel">
  <h3><span class="spinner"></span> Pipeline Running — <span id="live-elapsed"></span></h3>
  <div class="live-stages" id="live-stages"></div>
  <div class="task-pool" id="task-pool" style="display:none">
    <h4>Task Pool</h4>
    <table>
      <thead>
        <tr>
          <th>Job</th>
          <th>Stage</th>
          <th>Title / Company</th>
          <th>Status</th>
          <th>Elapsed</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="task-pool-body"></tbody>
    </table>
  </div>
</div>

<div class="source-label">
  <strong>JOB BOARDS</strong>
  <span class="source-icons">Greenhouse · Lever · Ashby · LinkedIn · Workday</span>
</div>

<div class="pipeline-flow">

  <!-- Step 1: Ingest ------------------------------------------------------ -->
  <div class="stage active">
    <div class="stage-header">
      <span class="stage-number">STEP 1</span>
      <span class="stage-title">Ingest</span>
      <span class="stage-cmd">pnpm jobbot add-url &lt;url&gt;</span>
    </div>
    <div class="comp-flow">
      <div class="comp comp-url"><div class="comp-title">Parse URL</div><div class="comp-detail">validate format</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-parse"><div class="comp-title">detect-ats.ts</div><div class="comp-detail">greenhouse · lever<br>ashby · workday<br>linkedin · generic</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-db"><div class="comp-title">INSERT INTO jobs</div><div class="comp-detail">url, ats_type<br>status='new'</div></div>
    </div>
    <div class="stage-foot">
      <strong><%= totalJobs %></strong> total ·
      <span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--green)"><%= ingestDone %></strong> moved on</span>
      <% if (ingestQueued.length > 0) { %>
        <span class="toggle-badge wait" onclick="toggleQueue('q-ingest-queued')">⏳ <%= ingestQueued.length %> queued</span>
      <% } else { %>
        <span class="toggle-badge empty">⏳ 0 queued</span>
      <% } %>
      <% if (ingestFailed.length > 0) { %>
        <span class="toggle-badge fail" onclick="toggleQueue('q-ingest-failed')">✕ <%= ingestFailed.length %> failed</span>
      <% } else { %>
        <span class="toggle-badge empty">✕ 0 failed</span>
      <% } %>
    </div>
    <!-- queued list -->
    <% if (ingestQueued.length > 0) { %>
    <div class="job-queue" id="q-ingest-queued">
      <p style="color:var(--text-dim);margin-bottom:6px">Awaiting extraction:</p>
      <% for (const j of ingestQueued) { %>
        <div class="job-queue-item">
          <span class="jid">#<%= j.id %></span>
          <a href="/jobs/<%= j.id %>"><%= j.url.substring(0, 70) %>…</a>
          <span class="tag"><%= j.ats_type %></span>
          <button class="queue-run-btn" onclick="event.preventDefault(); runJobStep(<%= j.id %>, 'extract')" title="Run extraction">▶</button>
          <button class="queue-del-btn" onclick="event.preventDefault(); deleteQueueJob(<%= j.id %>)" title="Delete">✕</button>
        </div>
      <% } %>
    </div>
    <% } %>
    <!-- failed list -->
    <% if (ingestFailed.length > 0) { %>
    <div class="job-queue" id="q-ingest-failed">
      <p style="color:var(--red);margin-bottom:6px">Extraction failed:</p>
      <% for (const j of ingestFailed) { %>
        <div class="job-queue-item">
          <span class="jid">#<%= j.id %></span>
          <a href="/jobs/<%= j.id %>"><%= j.url.substring(0, 50) %>…</a>
          <span class="err"><%= j.score_reason %></span>
          <button class="queue-run-btn" onclick="event.preventDefault(); runJobStep(<%= j.id %>, 'extract')" title="Retry extraction">▶</button>
          <button class="queue-del-btn" onclick="event.preventDefault(); deleteQueueJob(<%= j.id %>)" title="Delete">✕</button>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- Step 2: Extract ----------------------------------------------------- -->
  <div class="stage <%= extractDone > 0 ? 'done' : '' %>">
    <div class="stage-header">
      <span class="stage-number">STEP 2</span>
      <span class="stage-title">Extract</span>
      <span class="stage-cmd">pnpm jobbot extract [--job &lt;id&gt;]</span>
    </div>
    <div class="comp-flow">
      <div class="comp comp-fetch"><div class="comp-title">fetch(url)</div><div class="comp-detail">HTTP GET</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-parse"><div class="comp-title">htmlToText()</div><div class="comp-detail">strip scripts<br>nav, styles</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-llm"><div class="comp-title">DeepSeek LLM</div><div class="comp-detail">prompts/extract-job.md</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-db"><div class="comp-title">UPDATE jobs</div><div class="comp-detail">title, company<br>location, description<br>apply_url</div></div>
    </div>
    <div class="stage-foot">
      <strong><%= extractDone + extractQueued.length %></strong> received ·
      <span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--green)"><%= extractDone %></strong> moved on</span>
      <% if (extractQueued.length > 0) { %>
        <span class="toggle-badge wait" onclick="toggleQueue('q-extract-queued')">⏳ <%= extractQueued.length %> queued</span>
      <% } else { %>
        <span class="toggle-badge empty">⏳ 0 queued</span>
      <% } %>
      <span class="toggle-badge empty">✕ 0 failed</span>
    </div>
    <% if (extractQueued.length > 0) { %>
    <div class="job-queue" id="q-extract-queued">
      <p style="color:var(--text-dim);margin-bottom:6px">Extracted, awaiting scoring:</p>
      <% for (const j of extractQueued) { %>
        <div class="job-queue-item">
          <span class="jid">#<%= j.id %></span>
          <a href="/jobs/<%= j.id %>"><%= j.title || 'Untitled' %></a>
          <% if (j.company) { %><span class="tag"><%= j.company %></span><% } %>
          <button class="queue-run-btn" onclick="event.preventDefault(); runJobStep(<%= j.id %>, 'score')" title="Run this step">▶</button>
          <button class="queue-del-btn" onclick="event.preventDefault(); deleteQueueJob(<%= j.id %>)" title="Delete">✕</button>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- Step 3: Score ------------------------------------------------------- -->
  <div class="stage <%= scoredCount > 0 ? 'done' : '' %>">
    <div class="stage-header">
      <span class="stage-number">STEP 3</span>
      <span class="stage-title">Score</span>
      <span class="stage-cmd">pnpm jobbot score</span>
    </div>
    <div class="comp-flow">
      <div class="comp comp-fetch"><div class="comp-title">Job Data</div><div class="comp-detail">title · company<br>location · description</div></div>
      <span class="comp-arrow">+</span>
      <div class="comp comp-parse"><div class="comp-title">Profile Revision</div><div class="comp-detail">candidate_json<br>preferences_json</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-llm"><div class="comp-title">DeepSeek LLM</div><div class="comp-detail">prompts/score-job.md<br>6 dimensions<br>deal-breaker check</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-db"><div class="comp-title">UPDATE jobs</div><div class="comp-detail">score (0.0–1.0)<br>tier (A/B/C/D)<br>score_reason</div></div>
    </div>
    <div class="stage-foot">
      <strong><%= scoredCount %></strong> scored ·
      <% if (tierCounts.A > 0) { %><span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--green)"><%= tierCounts.A %> A</strong></span><% } %>
      <% if (tierCounts.B > 0) { %><span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--accent)"><%= tierCounts.B %> B</strong></span><% } %>
      <% if (tierCounts.C > 0) { %><span class="metric"><span class="dot dot-wait"></span> <strong style="color:var(--yellow)"><%= tierCounts.C %> C</strong></span><% } %>
      <% if (tierCounts.D > 0) { %><span class="metric"><span class="dot dot-fail"></span> <strong style="color:var(--red)"><%= tierCounts.D %> D</strong> (skipped)</span><% } %>
    </div>
  </div>

  <!-- Step 4: Compose ---------------------------------------------------- -->
  <div class="stage <%= composeDone > 0 ? 'done' : 'active' %>">
    <div class="stage-header">
      <span class="stage-number">STEP 4</span>
      <span class="stage-title">Compose</span>
      <span class="stage-cmd">pnpm jobbot compose --job &lt;id&gt;</span>
    </div>
    <div class="comp-flow">
      <div class="comp comp-fetch"><div class="comp-title">Job + Profile</div><div class="comp-detail">frozen snapshot<br>active profile revision</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-llm"><div class="comp-title">DeepSeek LLM</div><div class="comp-detail">prompts/tailor-resume.md<br>select + reorder<br>rephrase bullets</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-render"><div class="comp-title">Inject + Render</div><div class="comp-detail">master.tex<br>replace placeholders<br>pdflatex → PDF</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-output"><div class="comp-title">PDF Output</div><div class="comp-detail">local/resumes/&lt;job-id&gt;/<br>resume.pdf</div></div>
    </div>
    <div class="stage-foot">
      <strong><%= composeEligible %></strong> eligible (A/B only) ·
      <% if (cSkipped > 0) { %><span class="metric"><span class="dot dot-warn"></span> <strong style="color:var(--yellow)"><%= cSkipped %> C</strong> manual</span><% } %>
      <% if (dSkipped > 0) { %><span class="metric"><span class="dot dot-fail"></span> <strong style="color:var(--red)"><%= dSkipped %> D</strong> skipped</span><% } %>
      <span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--green)"><%= composeDone %></strong> composed</span>
      <% if (composeQueued.length > 0) { %>
        <span class="toggle-badge wait" onclick="toggleQueue('q-compose-queued')">⏳ <%= composeQueued.length %> queued</span>
      <% } else { %>
        <span class="toggle-badge empty">⏳ 0 queued</span>
      <% } %>
      <span class="toggle-badge empty">✕ 0 failed</span>
    </div>
    <% if (composeQueued.length > 0) { %>
    <div class="job-queue" id="q-compose-queued">
      <p style="color:var(--text-dim);margin-bottom:6px">Scored, awaiting composition:</p>
      <% for (const j of composeQueued) { %>
        <div class="job-queue-item">
          <span class="jid">#<%= j.id %></span>
          <a href="/jobs/<%= j.id %>"><%= j.title || 'Untitled' %></a>
          <% if (j.company) { %><span class="tag"><%= j.company %></span><% } %>
          <button class="queue-run-btn" onclick="event.preventDefault(); runJobStep(<%= j.id %>, 'compose')" title="Run compose">▶</button>
          <button class="queue-del-btn" onclick="event.preventDefault(); deleteQueueJob(<%= j.id %>)" title="Delete">✕</button>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- Step 5: Audit ------------------------------------------------------ -->
  <div class="stage <%= auditDone > 0 ? 'done' : 'active' %>">
    <div class="stage-header">
      <span class="stage-number">STEP 5</span>
      <span class="stage-title">Audit</span>
      <span class="stage-cmd">pnpm jobbot audit --job &lt;id&gt;</span>
    </div>
    <div class="comp-flow">
      <div class="comp comp-fetch"><div class="comp-title">Resume PDF</div><div class="comp-detail">rendered resume<br>pdftotext → text</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-llm"><div class="comp-title">Content Audit</div><div class="comp-detail">Reviewer committee<br>ATS · hiring manager · format</div></div>
      <span class="comp-arrow">+</span>
      <div class="comp comp-parse"><div class="comp-title">Visual Audit</div><div class="comp-detail">pdftoppm → PNG<br>Claude Vision<br>layout · formatting</div></div>
      <span class="comp-arrow">→</span>
      <div class="comp comp-output"><div class="comp-title">Audit Report</div><div class="comp-detail">content + visual score<br>issues + suggestions<br>audit.json</div></div>
    </div>
    <div class="stage-foot">
      <strong><%= auditDone + auditQueued.length %></strong> eligible ·
      <span class="metric"><span class="dot dot-ok"></span> <strong style="color:var(--green)"><%= auditDone %></strong> audited</span>
      <% if (auditQueued.length > 0) { %>
        <span class="toggle-badge wait" onclick="toggleQueue('q-audit-queued')">⏳ <%= auditQueued.length %> queued</span>
      <% } else { %>
        <span class="toggle-badge empty">⏳ 0 queued</span>
      <% } %>
      <span class="toggle-badge empty">✕ 0 failed</span>
    </div>
    <% if (auditQueued.length > 0) { %>
    <div class="job-queue" id="q-audit-queued">
      <p style="color:var(--text-dim);margin-bottom:6px">Composed, awaiting audit:</p>
      <% for (const j of auditQueued) { %>
        <div class="job-queue-item">
          <span class="jid">#<%= j.id %></span>
          <a href="/jobs/<%= j.id %>"><%= j.title || 'Untitled' %></a>
          <% if (j.company) { %><span class="tag"><%= j.company %></span><% } %>
          <button class="queue-run-btn" onclick="event.preventDefault(); runJobStep(<%= j.id %>, 'audit')" title="Run this step">▶</button>
          <button class="queue-del-btn" onclick="event.preventDefault(); deleteQueueJob(<%= j.id %>)" title="Delete">✕</button>
        </div>
      <% } %>
    </div>
    <% } %>
  </div>

</div>

<script>
  const STAGE_NAMES = { extract: 'Extract', score: 'Score', compose: 'Compose', audit: 'Audit' };
  let pollTimer = null;
  let pipelineStart = null;
  // Track when completed tasks first appeared — hide after DONE_TTL_MS
  const DONE_TTL_MS = 5000;
  const doneTaskFirstSeen = new Map(); // key: "stage:jobId" → Date.now()

  function toggleQueue(id) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('open');
  }
  async function runJobStep(id, step) {
    const btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳';
    try {
      const resp = await fetch('/api/run/step', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobId: id, step }),
      });
      const data = await resp.json();
      if (data.ok) {
        setTimeout(() => window.location.reload(), 2000);
      } else {
        alert(`Failed: ${data.error}`);
        btn.disabled = false;
        btn.textContent = '▶';
      }
    } catch (err) {
      alert(`Error: ${err.message}`);
      btn.disabled = false;
      btn.textContent = '▶';
    }
  }
  async function deleteQueueJob(id) {
    if (!confirm(`Delete job #${id}?\n\nThis is permanent and cannot be undone.`)) return;
    const resp = await fetch(`/api/jobs/${id}/delete`, { method: 'POST' });
    if (resp.ok) {
      window.location.reload();
    } else {
      const data = await resp.json();
      alert(`Delete failed: ${data.error}`);
    }
  }

  async function startPipeline() {
    // Check if already running
    const statusResp = await fetch('/api/pipeline/status');
    const statusData = await statusResp.json();
    if (statusData.running) {
      showLivePanel(statusData);
      pollProgress();
      return;
    }

    const step = document.getElementById('run-step').value;
    const body = step ? { step } : {};
    const resp = await fetch('/api/run', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await resp.json();
    if (!data.ok && resp.status === 409) {
      alert('Pipeline is already running.');
      pollProgress();
      return;
    }
    if (!data.ok) {
      alert('Failed to start: ' + (data.error || 'unknown'));
      return;
    }
    pipelineStart = Date.now();
    document.getElementById('run-btn').disabled = true;
    document.getElementById('cancel-btn').style.display = 'inline-block';
    document.getElementById('run-progress').style.display = 'block';
    document.getElementById('run-spinner').style.display = 'inline';
    document.getElementById('run-stage').textContent = 'Starting...';
    pollProgress();
  }

  async function cancelPipeline() {
    if (!confirm('Cancel the running pipeline? Already-running tasks will finish but no new tasks will start.')) return;
    const resp = await fetch('/api/pipeline/cancel', { method: 'POST' });
    const data = await resp.json();
    if (data.ok) {
      document.getElementById('run-stage').textContent = 'Cancelling...';
      document.getElementById('cancel-btn').disabled = true;
      document.getElementById('cancel-btn').textContent = 'Cancelling...';
    }
  }

  function fmtElapsed(sec) {
    if (sec < 60) return sec + 's';
    return Math.floor(sec / 60) + 'm ' + (sec % 60) + 's';
  }

  function showLivePanel(snap) {
    const panel = document.getElementById('live-panel');
    if (!snap.running) {
      panel.classList.remove('open');
      return;
    }
    panel.classList.add('open');

    // Elapsed time
    if (snap.startedAt) {
      const elapsed = Math.floor((Date.now() - new Date(snap.startedAt).getTime()) / 1000);
      document.getElementById('live-elapsed').textContent = fmtElapsed(elapsed);
    }

    // Render per-stage progress (compact)
    const container = document.getElementById('live-stages');
    const stages = ['extract', 'score', 'compose', 'audit'];
    let html = '';
    for (const s of stages) {
      const ss = snap.stages[s];
      if (!ss || ss.total === 0) continue;
      const done = ss.completed.length + ss.failed.length + ss.cancelled.length;
      const pct = ss.total > 0 ? Math.round((done / ss.total) * 100) : 0;
      const isActive = ss.running.length > 0;
      const isDone = done >= ss.total && ss.total > 0;
      const cls = isDone ? 'done' : (isActive || snap.stage === s) ? 'active' : '';
      html += '<div class="live-stage ' + cls + '">';
      html += '<div class="ls-name">' + STAGE_NAMES[s] + ' <span style="color:var(--text-dim)">' + done + '/' + ss.total + '</span></div>';
      html += '<div class="ls-bar"><div class="ls-bar-fill" style="width:' + pct + '%"></div></div>';
      let statParts = ['✓' + ss.completed.length, '✕' + ss.failed.length];
      if (ss.cancelled.length) statParts.push('⊘' + ss.cancelled.length);
      if (isActive) statParts.push('▶' + ss.running.length);
      html += '<div class="ls-stats">' + statParts.join(' ') + '</div>';
      if (ss.running.length > 0) {
        html += '<div class="ls-running">Running: #' + ss.running.join(', #') + '</div>';
      }
      html += '</div>';
    }
    container.innerHTML = html;

    // Render task pool table
    renderTaskPool(snap);
  }

  function renderTaskPool(snap) {
    const poolDiv = document.getElementById('task-pool');
    const tbody = document.getElementById('task-pool-body');
    const stages = ['extract', 'score', 'compose', 'audit'];
    const now = Date.now();

    // Collect all tasks with status
    const tasks = [];
    // Track which done tasks are still visible (to detect newly-gone ones for cleanup)
    const activeDoneKeys = new Set();
    for (const s of stages) {
      const ss = snap.stages[s];
      if (!ss) continue;
      // Running
      for (const rd of (ss.runningDetails || [])) {
        tasks.push({
          jobId: rd.jobId, title: rd.title, company: rd.company,
          stage: s, status: 'running', elapsedSec: rd.elapsedSec,
        });
      }
      // Completed — only show if first seen < DONE_TTL_MS ago.
      // Once expired, keep the entry in doneTaskFirstSeen so it never reappears.
      for (const jid of (ss.completed || [])) {
        const key = s + ':' + jid;
        if (!doneTaskFirstSeen.has(key)) doneTaskFirstSeen.set(key, now);
        const firstSeen = doneTaskFirstSeen.get(key);
        if (now - firstSeen < DONE_TTL_MS) {
          activeDoneKeys.add(key);
          const age = now - firstSeen;
          tasks.push({ jobId: jid, stage: s, status: 'done', ageMs: age });
        }
        // Else: expired — silently skip, but DON'T delete from doneTaskFirstSeen
        // so it stays expired even if the server still reports it as completed.
      }
      // Failed
      for (const jid of (ss.failed || [])) {
        tasks.push({ jobId: jid, stage: s, status: 'fail' });
      }
      // Cancelled
      for (const jid of (ss.cancelled || [])) {
        tasks.push({ jobId: jid, stage: s, status: 'cancelled' });
      }
    }
    // Collect all completed keys from the server snapshot
    const serverCompletedKeys = new Set();
    for (const s of stages) {
      const ss = snap.stages[s];
      if (!ss) continue;
      for (const jid of (ss.completed || [])) serverCompletedKeys.add(s + ':' + jid);
    }
    // Only delete entries for tasks that are no longer completed at all
    // (e.g., the pipeline was restarted and the task was re-queued).
    // Expired entries stay in the map so they never reappear.
    for (const key of doneTaskFirstSeen.keys()) {
      if (!serverCompletedKeys.has(key)) doneTaskFirstSeen.delete(key);
    }

    if (tasks.length === 0) {
      poolDiv.style.display = 'none';
      return;
    }
    poolDiv.style.display = '';

    // Sort: running first (by stage order), then completed/failed/cancelled
    const stageOrder = { extract: 0, score: 1, compose: 2, audit: 3 };
    tasks.sort((a, b) => {
      if (a.status === 'running' && b.status !== 'running') return -1;
      if (b.status === 'running' && a.status !== 'running') return 1;
      if (a.stage !== b.stage) return stageOrder[a.stage] - stageOrder[b.stage];
      return a.jobId - b.jobId;
    });

    const statusIcons = {
      running: '<span class="task-status running"><span class="task-spinner"></span> Running</span>',
      done: '<span class="task-status done">✓ Done</span>',
      fail: '<span class="task-status fail">✕ Failed</span>',
      cancelled: '<span class="task-status cancelled">⊘ Cancelled</span>',
    };

    let rows = '';
    for (const t of tasks) {
      const elapsed = t.elapsedSec ? fmtElapsed(t.elapsedSec) : '—';
      const label = t.title
        ? (t.title || '') + (t.company ? ' <span style="color:var(--text-dim)">@ ' + t.company + '</span>' : '')
        : '<span style="color:var(--text-dim)">—</span>';
      const stageBadge = '<span style="color:var(--text-dim);font-size:10px;text-transform:uppercase">' + (STAGE_NAMES[t.stage] || t.stage) + '</span>';
      const cancelBtn = t.status === 'running'
        ? '<button class="btn-task-cancel" onclick="cancelTask(' + t.jobId + ')">Cancel</button>'
        : '';

      // Animation: new done tasks get a fade-in, expiring ones get a fade-out
      let rowClass = '';
      if (t.status === 'done' && t.ageMs !== undefined) {
        if (t.ageMs < 300) rowClass = ' new-done';
        if (t.ageMs > DONE_TTL_MS - 1000) rowClass = ' fading';
      }

      rows += '<tr class="task-row' + rowClass + '">';
      rows += '<td style="font-variant-numeric:tabular-nums;font-weight:600">#' + t.jobId + '</td>';
      rows += '<td>' + stageBadge + '</td>';
      rows += '<td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + label + '</td>';
      rows += '<td>' + statusIcons[t.status] + '</td>';
      rows += '<td style="font-variant-numeric:tabular-nums;color:var(--text-dim)">' + elapsed + '</td>';
      rows += '<td style="text-align:right">' + cancelBtn + '</td>';
      rows += '</tr>';
    }
    tbody.innerHTML = rows;
  }

  async function cancelTask(jobId) {
    if (!confirm('Cancel task #' + jobId + '? The in-progress API call will be aborted.')) return;
    try {
      const resp = await fetch('/api/pipeline/tasks/' + jobId + '/cancel', { method: 'POST' });
      const data = await resp.json();
      if (!data.ok) {
        alert('Failed to cancel: ' + (data.error || 'unknown'));
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }

  async function pollProgress() {
    const resp = await fetch('/api/pipeline/status');
    const snap = await resp.json();

    if (snap.running) {
      // Update simple progress
      let msg = snap.stage ? STAGE_NAMES[snap.stage] : 'Running...';
      document.getElementById('run-stage').textContent = msg;
      document.getElementById('run-spinner').style.display = 'inline';
      document.getElementById('run-btn').disabled = true;
      document.getElementById('cancel-btn').style.display = 'inline-block';

      // Update live panel
      showLivePanel(snap);

      pollTimer = setTimeout(pollProgress, 1000);
    } else {
      // Pipeline finished
      document.getElementById('run-spinner').style.display = 'none';
      document.getElementById('run-btn').disabled = false;
      document.getElementById('cancel-btn').style.display = 'none';
      document.getElementById('run-stage').textContent = snap.finishedAt ? 'Complete — reloading...' : 'Idle';
      document.getElementById('live-panel').classList.remove('open');
      if (snap.finishedAt) {
        setTimeout(() => window.location.reload(), 1500);
      }
    }
  }

  // On page load, check if pipeline is already running
  (async function checkRunning() {
    try {
      const resp = await fetch('/api/pipeline/status');
      const snap = await resp.json();
      if (snap.running) {
        document.getElementById('run-btn').disabled = true;
        document.getElementById('cancel-btn').style.display = 'inline-block';
        document.getElementById('run-progress').style.display = 'block';
        showLivePanel(snap);
        pollProgress();
      }
    } catch (e) { /* ignore */ }
  })();
</script>

<%- include('_foot') %>
