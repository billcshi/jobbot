  function translated(source) {
    if (locale !== 'zh-CN') return source;
    if (ZH[source]) return ZH[source];
    for (const [pattern, replacement] of patterns) {
      if (pattern.test(source)) return source.replace(pattern, replacement);
    }
    const decorated = source.match(/^([^A-Za-z0-9]+)([A-Za-z].*)$/s);
    if (decorated) {
      const translatedRemainder = translated(decorated[2]);
      if (translatedRemainder !== decorated[2]) return decorated[1] + translatedRemainder;
    }
    for (const [pattern, replacement] of messagePatterns) {
      if (pattern.test(source)) return source.replace(pattern, replacement);
    }
    return source;
  }

  function translateTextNode(node) {
    if (isTranslationSkipped(node)) return;
    const current = node.nodeValue || '';
    const previous = textState.get(node);
    const source = previous && current === previous.rendered ? previous.source : current;
    const leading = source.match(/^\s*/)?.[0] || '';
    const trailing = source.match(/\s*$/)?.[0] || '';
    const core = source.slice(leading.length, source.length - trailing.length);
    if (!core) return;
    const rendered = leading + translated(core) + trailing;
    textState.set(node, { source, rendered });
    if (current !== rendered) node.nodeValue = rendered;
  }

  function translateAttribute(element, name) {
    if (isTranslationSkipped(element)) return;
    if (!element.hasAttribute(name)) return;
    let state = attributeState.get(element);
    if (!state) {
      state = {};
      attributeState.set(element, state);
    }
    const current = element.getAttribute(name) || '';
    const previous = state[name];
    const source = previous && current === previous.rendered ? previous.source : current;
    const rendered = translated(source);
    state[name] = { source, rendered };
    if (current !== rendered) element.setAttribute(name, rendered);
  }

  function isTranslationSkipped(node) {
    const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
    return Boolean(element?.closest?.('[data-i18n-skip]'));
  }

  function translateTree(root = document.body) {
    if (!root) return;
    const visit = (node) => {
      if (isTranslationSkipped(node)) return;
      if (node.nodeType === Node.TEXT_NODE) {
        translateTextNode(node);
        return;
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return;
      const element = node;
      if (element.matches('[data-language-toggle]')) return;
      translateAttribute(element, 'placeholder');
      translateAttribute(element, 'title');
      translateAttribute(element, 'aria-label');
      if (element.matches('script, style, code, pre, textarea, [data-i18n-skip]')) return;
      for (const child of element.childNodes) visit(child);
    };
    visit(root);
  }

  function updateToggle() {
    for (const button of document.querySelectorAll('[data-language-toggle]')) {
      button.textContent = locale === 'zh-CN' ? 'EN' : '中文';
      button.title = locale === 'zh-CN' ? 'Switch to English' : '切换到中文';
      button.setAttribute('aria-label', button.title);
    }
  }

  function applyLocale() {
    document.documentElement.lang = locale;
    document.title = locale === 'zh-CN' && titleShouldTranslate
      ? titleSource.split(' — ').map(part => translated(part)).join(' — ')
      : titleSource;
    translateTree(document.body);
    updateToggle();
  }

  function setLocale(nextLocale) {
    locale = nextLocale === 'zh-CN' ? 'zh-CN' : 'en';
    localStorage.setItem(STORAGE_KEY, locale);
    applyLocale();
    window.dispatchEvent(new CustomEvent('jobbot:localechange', { detail: { locale } }));
  }

  document.addEventListener('click', (event) => {
    if (event.target.closest('[data-language-toggle]')) {
      setLocale(locale === 'zh-CN' ? 'en' : 'zh-CN');
    }
  });

  const nativeAlert = window.alert.bind(window);
  const nativeConfirm = window.confirm.bind(window);
  window.alert = message => nativeAlert(translated(String(message)));
  window.confirm = message => nativeConfirm(translated(String(message)));
  window.jobbotI18n = Object.freeze({
    get locale() { return locale; },
    setLocale,
    translate: value => translated(String(value)),
    apply: applyLocale,
  });

  const observer = new MutationObserver(mutations => {
    for (const mutation of mutations) {
      if (mutation.type === 'characterData' && !isTranslationSkipped(mutation.target)) translateTextNode(mutation.target);
      for (const node of mutation.addedNodes) {
        if ((node.nodeType === Node.ELEMENT_NODE || node.nodeType === Node.TEXT_NODE) && !isTranslationSkipped(node)) translateTree(node);
      }
    }
  });
  observer.observe(document.body, { childList: true, characterData: true, subtree: true });
  applyLocale();
})();
</script>
