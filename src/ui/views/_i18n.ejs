  const messagePatterns = [
    [/^Error: (.+)$/s, '错误：$1'],
    [/^Failed: (.+)$/s, '失败：$1'],
    [/^Delete failed: (.+)$/s, '删除失败：$1'],
    [/^Failed to start: (.+)$/s, '启动失败：$1'],
    [/^Delete job #(\d+): "(.+)"\?\n\nThis is permanent and cannot be undone\.$/s, '删除职位 #$1：“$2”？\n\n此操作不可撤销。'],
    [/^Delete job #(\d+)\?\n\nThis is permanent and cannot be undone\.$/s, '删除职位 #$1？\n\n此操作不可撤销。'],
    [/^Delete ALL D-tier jobs\?\n\nThis is permanent and cannot be undone\.$/s, '删除所有 D 级职位？\n\n此操作不可撤销。'],
    [/^Mark this job as applied\?$/s, '将此职位标记为已申请？'],
    [/^Cancel the running pipeline\? Already-running tasks will finish but no new tasks will start\.$/s, '取消正在运行的流水线？正在执行的任务会完成，但不会启动新任务。'],
