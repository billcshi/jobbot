<%- include('_head', { title: 'Dashboard' }) %>

<h1 style="font-size:20px;font-weight:600;margin-bottom:20px;">Job Pipeline</h1>

<!-- stats bar -->
<div class="stats-bar">
  <div class="stat"><strong><%= totalJobs %></strong> total</div>
  <% if (counts.A > 0) { %><div class="stat"><strong style="color:var(--green)"><%= counts.A %></strong> A</div><% } %>
  <% if (counts.B > 0) { %><div class="stat"><strong style="color:var(--accent)"><%= counts.B %></strong> B</div><% } %>
  <% if (counts.C > 0) { %><div class="stat"><strong style="color:var(--yellow)"><%= counts.C %></strong> C</div><% } %>
  <% if (counts.D > 0) { %><div class="stat"><strong style="color:var(--red)"><%= counts.D %></strong> D</div><% } %>
  <% if (counts.D > 0) { %>
    <div class="stat" style="cursor:pointer" onclick="deleteAllD()" title="Delete all D-tier jobs">
      🗑️ Delete all D
    </div>
  <% } %>
</div>

<!-- analytics charts -->
<% if (totalJobs > 0) { %>
<div class="grid-2" style="margin-bottom:20px">
  <!-- Tier Distribution -->
  <div class="card">
    <h2>Tier Distribution</h2>
    <div style="padding:8px 0">
      <% const tiers = ['A','B','C','D']; const maxTier = Math.max(counts.A, counts.B, counts.C, counts.D, 1); %>
      <% for (const t of tiers) { %>
        <% const tc = counts[t]; const tw = Math.max((tc / maxTier) * 100, 2); %>
        <% const tcolors = { A: 'var(--green)', B: 'var(--accent)', C: 'var(--yellow)', D: 'var(--red)' }; %>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
          <span style="width:20px;font-size:12px;font-weight:700;text-align:right;color:<%= tcolors[t] %>"><%= t %></span>
          <div style="flex:1;background:var(--bg);border-radius:4px;height:20px;overflow:hidden">
            <div style="width:<%= tw %>%;height:100%;background:<%= tcolors[t] %>;border-radius:4px;transition:width 0.3s"></div>
          </div>
          <span style="width:36px;font-size:12px;color:var(--text-dim);text-align:right"><%= tc %></span>
          <span style="width:48px;font-size:11px;color:var(--text-dim)"><%= ((tc / totalJobs) * 100).toFixed(0) %>%</span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pipeline Funnel -->
  <div class="card">
    <h2>Pipeline Funnel</h2>
    <svg width="100%" height="192" viewBox="0 0 300 192" style="display:block;margin:0 auto">
      <% const stages = [
        { label: 'Ingested', count: stageCounts.ingested, color: '#8b949e' },
        { label: 'Extracted', count: stageCounts.extracted, color: '#58a6ff' },
        { label: 'Scored', count: stageCounts.scored, color: '#a371f7' },
        { label: 'Composed', count: stageCounts.composed, color: '#d2991d' },
        { label: 'Audited', count: stageCounts.audited, color: '#3fb950' },
      ];
      const maxCount = Math.max(totalJobs, 1);
      const barH = 26;
      const gap = 10;
      %>
      <% for (let i = 0; i < stages.length; i++) { %>
        <% const s = stages[i]; %>
        <% const sw = Math.max((s.count / maxCount) * 220, 30); %>
        <% const sx = 80 + (220 - sw) / 2; %>
        <% const sy = 10 + i * (barH + gap); %>
        <text x="72" y="<%= sy + 17 %>" text-anchor="end" fill="#8b949e" font-size="11" font-family="sans-serif"><%= s.label %></text>
        <rect x="<%= sx %>" y="<%= sy %>" width="<%= sw %>" height="<%= barH %>" rx="4" fill="<%= s.color %>" opacity="0.85"/>
        <text x="<%= sx + sw/2 %>" y="<%= sy + 17 %>" text-anchor="middle" fill="#fff" font-size="11" font-weight="600" font-family="sans-serif"><%= s.count %></text>
      <% } %>
    </svg>
  </div>
</div>

<!-- Top Companies -->
<% if (topCompanies.length > 0) { %>
<div class="card" style="margin-bottom:20px">
  <h2>Top Companies</h2>
  <div style="display:flex;flex-wrap:wrap;gap:6px">
    <% for (const c of topCompanies) { %>
      <span class="stat" style="font-size:12px"><%= c.company %> <strong style="font-size:13px"><%= c.count %></strong></span>
    <% } %>
  </div>
</div>
<% } %>

<% } %>

<!-- filter bar -->
<div class="filter-bar">
  <label>Tier:
    <select onchange="filter('tier', this.value)">
      <option value="">All</option>
      <option value="A" <%= filters.tier === 'A' ? 'selected' : '' %>>A — Top Match</option>
      <option value="B" <%= filters.tier === 'B' ? 'selected' : '' %>>B — Good Match</option>
      <option value="C" <%= filters.tier === 'C' ? 'selected' : '' %>>C — Possible</option>
      <option value="D" <%= filters.tier === 'D' ? 'selected' : '' %>>D — Low / Deal-breaker</option>
    </select>
  </label>
  <label>Status:
    <select onchange="filter('status', this.value)">
      <option value="">All</option>
      <option value="new" <%= filters.status === 'new' ? 'selected' : '' %>>New</option>
      <option value="extracted" <%= filters.status === 'extracted' ? 'selected' : '' %>>Extracted</option>
      <option value="scored" <%= filters.status === 'scored' ? 'selected' : '' %>>Scored</option>
      <option value="composed" <%= filters.status === 'composed' ? 'selected' : '' %>>Composed</option>
      <option value="audited" <%= filters.status === 'audited' ? 'selected' : '' %>>Audited</option>
      <option value="audit_failed" <%= filters.status === 'audit_failed' ? 'selected' : '' %>>Audit Failed</option>
    </select>
  </label>
  <label>Applied:
    <select onchange="filter('applied', this.value)">
      <option value="hide" <%= filters.applied === 'hide' ? 'selected' : '' %>>Hide applied</option>
      <option value="all" <%= filters.applied === 'all' ? 'selected' : '' %>>Show all</option>
      <option value="only" <%= filters.applied === 'only' ? 'selected' : '' %>>Applied only</option>
    </select>
  </label>
  <label>Sort:
    <select onchange="filter('sort', this.value)">
      <option value="score" <%= filters.sort === 'score' ? 'selected' : '' %>>Score (high first)</option>
      <option value="company" <%= filters.sort === 'company' ? 'selected' : '' %>>Company (A-Z)</option>
      <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
      <option value="date" <%= filters.sort === 'date' ? 'selected' : '' %>>Date added (newest)</option>
    </select>
  </label>
</div>

<!-- job table -->
<% if (jobs.length === 0) { %>
  <div class="empty">
    <p style="font-size:32px;">📭</p>
    <p>No jobs match the current filters.</p>
  </div>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Tier</th>
        <th>Score</th>
        <th>Company</th>
        <th>Title</th>
        <th>ATS</th>
        <th>Status</th>
        <th>URL</th>
        <th style="width:30px"></th>
      </tr>
    </thead>
    <tbody>
      <% for (const job of jobs) { %>
        <% const displayScore = job.user_score != null ? job.user_score : job.score; %>
        <% const displayTier = job.user_tier || job.tier; %>
        <tr class="clickable" onclick="location.href='/jobs/<%= job.id %>'">
          <td><%= job.id %></td>
          <td><span class="badge <%= helpers.tierClass(displayTier) %>"><%= helpers.tierLabel(displayTier) %></span></td>
          <td style="font-variant-numeric:tabular-nums"><%= helpers.scoreFmt(displayScore) %></td>
          <td><%= helpers.truncate(job.company, 25) %></td>
          <td style="max-width:250px"><%= helpers.truncate(job.title, 40) %></td>
          <td><%= job.ats_type %></td>
          <td><span class="status-badge"><%= helpers.statusLabel(job.status) %></span></td>
          <td><a href="<%= job.url %>" class="url-link" onclick="event.stopPropagation()" target="_blank" title="<%= job.url %>"><%= helpers.truncate(job.url, 35) %></a></td>
          <td><button class="delete-btn" onclick="event.stopPropagation(); deleteJob(<%= job.id %>, '<%= (job.title || 'Untitled').replace(/'/g, "\\'") %>')" title="Delete">✕</button></td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <p style="margin-top:12px;font-size:12px;color:var(--text-dim)"><%= jobs.length %> job(s)</p>
<% } %>

<script>
  function filter(key, value) {
    const url = new URL(window.location);
    if (value) {
      url.searchParams.set(key, value);
    } else {
      url.searchParams.delete(key);
    }
    window.location = url.toString();
  }

  async function deleteJob(id, label) {
    if (!confirm(`Delete job #${id}: "${label}"?\n\nThis is permanent and cannot be undone.`)) return;
    const resp = await fetch(`/api/jobs/${id}/delete`, { method: 'POST' });
    if (resp.ok) {
      window.location.reload();
    } else {
      const data = await resp.json();
      alert(`Delete failed: ${data.error}`);
    }
  }

  async function deleteAllD() {
    if (!confirm('Delete ALL D-tier jobs?\n\nThis is permanent and cannot be undone.')) return;
    const resp = await fetch('/api/jobs/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tier: 'D' }),
    });
    if (resp.ok) {
      window.location.reload();
    } else {
      const data = await resp.json();
      alert(`Delete failed: ${data.error}`);
    }
  }

  async function deleteByStatus(status, label) {
    if (!confirm(`Delete ALL jobs with status "${label}"?\n\nThis is permanent and cannot be undone.`)) return;
    const resp = await fetch('/api/jobs/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status }),
    });
    if (resp.ok) {
      window.location.reload();
    } else {
      const data = await resp.json();
      alert(`Delete failed: ${data.error}`);
    }
  }
</script>

<%- include('_foot') %>
