<%- include('_head', { title: 'Event Timeline' }) %>

<h1 style="font-size:20px;font-weight:600;margin-bottom:8px;">Event Timeline</h1>
<p style="color:var(--text-muted);margin-bottom:20px;font-size:13px">Every state transition across all jobs. From URL ingestion to audit pass/fail.</p>

<div class="filter-bar">
  <label>Job:
    <select onchange="filter('job', this.value)">
      <option value="">All</option>
      <%
        const shown = new Set();
        for (const e of events) {
          if (e.job_id && !shown.has(e.job_id)) {
            shown.add(e.job_id);
      %>
          <option value="<%= e.job_id %>" <%= filters.job == e.job_id ? 'selected' : '' %>>#<%= e.job_id %> — <%= e.job_title || e.job_company || 'Deleted' %></option>
      <% } } %>
    </select>
  </label>
  <label>Type:
    <select onchange="filter('type', this.value)">
      <option value="">All</option>
      <% for (const t of eventTypes) { %>
        <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
      <% } %>
    </select>
  </label>
</div>

<% if (events.length === 0) { %>
  <div class="empty"><p style="font-size:32px">📭</p><p>No events yet.</p></div>
<% } else { %>
  <div class="timeline">
    <% for (const e of events) { %>
      <div class="tl-entry">
        <div class="tl-dot dot-<%= e.event_type %>"></div>
        <div class="tl-content">
          <span class="tl-time"><%= e.created_at %></span>
          <a href="/jobs/<%= e.job_id %>" class="tl-job">#<%= e.job_id %><% if (e.job_title) { %> — <%= e.job_title.slice(0, 40) %><% } %></a>
          <span class="tl-badge badge-<%= e.event_type %>"><%= e.event_type %></span>
          <span class="tl-desc"><%= e.description || '' %></span>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<style>
.timeline { position: relative; padding-left: 32px; }
.timeline::before {
  content: ''; position: absolute; left: 7px; top: 0; bottom: 0;
  width: 2px; background: var(--border);
}
.tl-entry {
  position: relative; padding: 8px 0 8px 16px;
  border-bottom: 1px solid rgba(48,54,61,0.4);
  display: flex; align-items: baseline; gap: 10px;
}
.tl-dot {
  position: absolute; left: -25px; top: 14px;
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--border); border: 2px solid var(--bg); z-index: 1;
}
.dot-ingest { background: var(--purple); }
.dot-extract { background: var(--accent); }
.dot-score { background: var(--green); }
.dot-compose { background: var(--yellow); }
.dot-audit_pass { background: var(--green); }
.dot-audit_fail { background: var(--red); }
.dot-delete { background: var(--red); }
.tl-time {
  font-size: 12px; color: var(--text-dim); white-space: nowrap;
  font-variant-numeric: tabular-nums; min-width: 130px;
}
.tl-job { font-size: 12px; color: var(--accent); text-decoration: none; white-space: nowrap; }
.tl-job:hover { text-decoration: underline; }
.tl-badge { font-size: 10px; padding: 1px 6px; border-radius: 3px; font-weight: 600; text-transform: uppercase; white-space: nowrap; }
.badge-ingest { background: rgba(163,113,247,0.15); color: var(--purple); }
.badge-extract { background: rgba(88,166,255,0.15); color: var(--accent); }
.badge-score { background: rgba(63,185,80,0.15); color: var(--green); }
.badge-compose { background: rgba(210,153,29,0.15); color: var(--yellow); }
.badge-audit_pass { background: rgba(63,185,80,0.15); color: var(--green); }
.badge-audit_fail { background: rgba(248,81,73,0.15); color: var(--red); }
.badge-delete { background: rgba(248,81,73,0.15); color: var(--red); }
.tl-desc { font-size: 13px; color: var(--text-muted); }
@media (max-width: 768px) {
  .tl-content { display: flex; flex-wrap: wrap; gap: 4px; }
  .tl-time { min-width: auto; }
}
</style>

<script>
  function filter(key, value) {
    const url = new URL(window.location);
    if (value) { url.searchParams.set(key, value); }
    else { url.searchParams.delete(key); }
    window.location = url.toString();
  }
</script>

<%- include('_foot') %>
